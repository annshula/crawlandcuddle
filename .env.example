# Copy to .env.local. NEVER commit secrets. NEVER prefix a secret with NEXT_PUBLIC_.

# Canonical origin — used for metadata, JSON-LD, sitemap.xml and robots.txt.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Shopify ───────────────────────────────────────────────────────────────
# Permanent myshopify domain (no protocol).
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_API_VERSION=2025-10

# Storefront API (public token — still proxied server-side).
#   Shopify admin → Sales channels → Headless → Storefront API
#   Permissions: read products, read product listings, manage/read checkouts (cart)
SHOPIFY_STOREFRONT_API_TOKEN=

# Admin GraphQL API — for `npm run shopify:sync` (product price sync).
SHOPIFY_ADMIN_CLIENT_ID=
SHOPIFY_ADMIN_CLIENT_SECRET=

# Customer Account API (OAuth 2.0 + PKCE) — used for login / orders / profile.
#   Callback URI: https://your-site.com/account/callback
#   Shopify admin → Headless channel → Customer Account API → copy shop ID +
#   the `shp_…` public client ID from the authorize endpoint shown there.
SHOPIFY_CUSTOMER_ACCOUNT_SHOP_ID=
SHOPIFY_CUSTOMER_ACCOUNT_CLIENT_ID=

# Session encryption (AES-256-GCM). Generate:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# ── Shopify webhooks (orders/paid + products/create|update) ──────────────
# Register/refresh them with:
#   npm run shopify:register-webhooks -- --website https://your-site.com
# App-created webhooks are signed with the custom app's CLIENT SECRET, so this
# value must equal SHOPIFY_ADMIN_CLIENT_SECRET — otherwise every delivery fails
# the HMAC check with a 401. Do NOT use the admin-UI webhook secret here: those
# subscriptions are signed with a secret the API never exposes.
SHOPIFY_WEBHOOK_SECRET=

# ── Catalog rebuild trigger (products/create|update webhook) ─────────────
# data/product.json is bundled into the build, so a Shopify product edit can
# only reach the storefront through a rebuild. Create a Vercel Deploy Hook
# (Project → Settings → Git → Deploy Hooks) and paste its URL here — the
# products webhook POSTs to it. Leave blank and the webhook still acks Shopify,
# but logs that nothing was rebuilt.
VERCEL_DEPLOY_HOOK_URL=

# ── Microsoft Clarity ─────────────────────────────────────────────────────
# Heatmaps + session replay. Public by design (it ships to the browser).
#   clarity.microsoft.com → your project → Settings → Overview → Project ID
# Leave blank to disable Clarity entirely.
NEXT_PUBLIC_CLARITY_PROJECT_ID=

# ── Meta Pixel ────────────────────────────────────────────────────────────
# Facebook/Instagram ads conversion tracking. Public by design (ships to the
# browser). business.facebook.com → Events Manager → Data sources → Pixel ID
# Leave blank to disable the pixel entirely.
NEXT_PUBLIC_META_PIXEL_ID=

# ── Google Analytics 4 ────────────────────────────────────────────────────
# gtag.js measurement. Public by design (ships to the browser).
#   Google Analytics → Admin → Data streams → your web stream → Measurement ID
# Leave blank to disable GA entirely.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# ── Google Tag Manager ────────────────────────────────────────────────────
# Tag-management container for the whole site. Public by design (ships to the
# browser). tagmanager.google.com → your container → Container ID (GTM-XXXXXXX).
# Leave blank to use the production container compiled into code.
NEXT_PUBLIC_GTM_ID=

# ── TikTok Pixel ──────────────────────────────────────────────────────────
# TikTok ads conversion tracking. Public by design (ships to the browser).
#   TikTok Ads Manager → Assets → Events → Web Events → your pixel → Pixel ID
# Leave blank to disable the pixel entirely.
NEXT_PUBLIC_TIKTOK_PIXEL_ID=

# ── TikTok Events API (server-side) ──────────────────────────────────────
# Sends the Purchase event from the orders/paid webhook — the shopper pays on
# Shopify's hosted checkout, so the browser pixel can never see the purchase.
# The pixel id is shared with the browser tag (NEXT_PUBLIC_TIKTOK_PIXEL_ID).
#   TikTok Ads Manager → Events → Web Events → your pixel → Events API → Generate access token
# Leave blank to skip TikTok server-side purchases.
TIKTOK_ACCESS_TOKEN=

# ── Meta Conversions API (server-side) ───────────────────────────────────
# Sends the Purchase event from the orders/paid webhook — the shopper pays on
# Shopify's hosted checkout, so the browser pixel can never see the purchase.
# The pixel id is shared with the browser tag (NEXT_PUBLIC_META_PIXEL_ID).
# business.facebook.com → Events Manager → Data sources → Settings → Conversions API
META_CAPI_ACCESS_TOKEN=
META_GRAPH_API_VERSION=v21.0

# Meta Events Manager → Test Events issues a per-account code that tags an
# event as test traffic: it shows up live in that tool but is excluded from ad
# optimization and reporting. Set only while verifying the Purchase pipeline
# end-to-end; leave unset in production so a manual test never counts as a real
# conversion.
# META_TEST_EVENT_CODE=

# ── GA4 Measurement Protocol (server-side) ───────────────────────────────
# API secret for server-side purchase events (same stream as the web tag).
#   Google Analytics → Admin → Data streams → your stream → Measurement
#   Protocol API secrets → Create. Leave blank to skip GA4 server-side purchases.
GA_MP_API_SECRET=
