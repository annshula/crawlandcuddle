# Copy to .env.local. NEVER commit secrets. NEVER prefix a secret with NEXT_PUBLIC_.

# Canonical origin — used for metadata, JSON-LD, sitemap.xml and robots.txt.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Shopify ───────────────────────────────────────────────────────────────
# Permanent myshopify domain (no protocol).
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_API_VERSION=2025-10

# Storefront API (public token — still proxied server-side).
#   Shopify admin → Sales channels → Headless → Storefront API
#   Permissions: read products, read product listings, manage/read checkouts (cart)
SHOPIFY_STOREFRONT_API_TOKEN=

# Admin GraphQL API — for `npm run shopify:sync` (product price sync).
SHOPIFY_ADMIN_CLIENT_ID=
SHOPIFY_ADMIN_CLIENT_SECRET=

# Customer Account API (OAuth 2.0 + PKCE) — used for login / orders / profile.
#   Callback URI: https://your-site.com/account/callback
#   Shopify admin → Headless channel → Customer Account API → copy shop ID +
#   the `shp_…` public client ID from the authorize endpoint shown there.
SHOPIFY_CUSTOMER_ACCOUNT_SHOP_ID=
SHOPIFY_CUSTOMER_ACCOUNT_CLIENT_ID=

# Session encryption (AES-256-GCM). Generate:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# ── Microsoft Clarity ─────────────────────────────────────────────────────
# Heatmaps + session replay. Public by design (it ships to the browser).
#   clarity.microsoft.com → your project → Settings → Overview → Project ID
# Leave blank to disable Clarity entirely.
NEXT_PUBLIC_CLARITY_PROJECT_ID=
